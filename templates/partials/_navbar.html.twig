<nav class="navbar custom-navbar px-4"
     style="background: linear-gradient(135deg, #001381ff, #050049ff);">

    <div class="container-fluid navbar-container w-100">

        <!-- =====================
             GAUCHE : BURGER (mobile)
             ===================== -->
        <div class="navbar-left">
            <!-- Burger visible sur mobile uniquement -->
            <button class="btn burger-btn"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasMenu"
                    aria-controls="offcanvasMenu">
                <img src="{{ asset('icons/menu-offcanvas-icon.png') }}"
                     alt="Menu"
                     height="24">
            </button>

            <!-- MENU OFFCANVAS (mobile uniquement) -->
            {{ include('partials/_menu_burger.html.twig') }}
        </div>

        <!-- =====================
             CENTRE : LOGO
             ===================== -->
        <div class="navbar-center">
            <a class="navbar-brand"
               href="{{ path('app_home') }}">
                <img src="{{ asset('icons/logo-192.png') }}"
                     alt="Home"
                     height="24">
            </a>
        </div>

        <!-- =====================
             MENU DESKTOP (centré)
             ===================== -->
        <div class="navbar-menu-desktop">
            <a href="{{ path('app_subscription') }}" class="menu-link">Abonnement</a>
            <a href="{{ path('app_feeling') }}" class="menu-link">Feeling</a>
            <a href="{{ path('app_action') }}" class="menu-link">Actions</a>
            <a href="{{ path('app_block') }}" class="menu-link">Blocages</a>
        </div>

        <!-- =====================
             DROITE : LOGIN / DASHBOARD
             ===================== -->
        <div class="navbar-right">

            {% if app.user %}
                <!-- Notifications -->
                <div class="nav-item dropdown me-3">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="notificationDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <img src="{{ asset('icons/notifications-icon.png') }}"
                             alt="Notifications"
                             height="24">
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        {{ include('notification/_index.html.twig', {
                            notifications: notifications|default([])
                        }) }}
                    </ul>
                </div>

                <!-- Dashboard -->
                <a href="{{ path('app_dashboard') }}"
                   class="btn btn-link dashboard-btn">
                    Dashboard
                </a>
            {% else %}
                <!-- Login -->
                <a href="{{ path('app_login') }}"
                   class="btn btn-link login-btn">
                    Login
                </a>
            {% endif %}

        </div>

    </div>
</nav>
