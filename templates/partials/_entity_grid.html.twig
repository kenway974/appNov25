{#
  Partial générique : grille desktop pour une entité
  -------------------------------------------------------
  Variables attendues :
    - items_by_group   (array)  : variable groupée, ex. actionsByIntension
    - item_key         (string) : nom de chaque item dans la boucle, ex. "action"
    - read_template    (string) : chemin du partial _read
    - text_bloc_vars   (object) : variables passées au partial _entity_text_bloc
    - prefix           (string) : préfixe d'id unique, ex. "desktop-action"
    - has_image_hero   (bool, optionnel) : afficher un category-hero avec image
    - image_base_path  (string, optionnel) : base du chemin image si has_image_hero
    - section_aria_id  (string, optionnel) : préfixe aria pour les sections
#}

<section class="mt-5" aria-labelledby="{{ item_key }}-title">

    {{ include('partials/_entity_text_bloc.html.twig', text_bloc_vars) }}

    {% for group_name, items in items_by_group %}
        <section class="mb-5" aria-labelledby="{{ section_aria_id|default('section-desktop') }}-{{ loop.index }}">

                <header class="category-hero">
                    <div class="category-bg">
                        <img src="{{ image_base_path ~ '/' ~ group_name|lower ~ '.jpg' }}"
                             alt="Bannière {{ group_name }}"
                             class="category-image">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-content">
                        <h2 class="category-title text-center mb-3">{{ group_name }}</h2>
                    </div>
                </header>

            <div class="row g-3">
                {% for item in items %}
                    {% set uniqueId = prefix ~ '-' ~ item.id ~ '-' ~ loop.index %}

                    <article class="col-md-4 entity-item">
                        <button class="entity-title"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#{{ uniqueId }}"
                                aria-expanded="false"
                                aria-controls="{{ uniqueId }}">

                            {% if item.icon is defined and item.icon %}
                                <img src="{{ asset('images/icons/' ~ item.icon) }}" width="24" class="me-2" alt="">
                            {% endif %}

                            {{ item.title }}
                        </button>

                        <div id="{{ uniqueId }}" class="collapse mt-2">
                            {{ include(read_template, { (item_key): item }) }}
                        </div>

                        {% if not loop.last %}
                            <hr class="entity-separator">
                        {% endif %}
                    </article>
                {% endfor %}
            </div>

        </section>
    {% endfor %}

</section>
