<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
    <div class="offcanvas-header">
        <img src="{{ asset('icons/logo.png') }}" class="offcanvas-title" id="offcanvasMenuLabel" alt="Logo"
             style="height:24px; width:auto; background:transparent;">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#offcanvasMenu" aria-label="Fermer"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="list-unstyled">
            {% if app.user %}
            <li><a class="dropdown-item" href="{{ path('app_dashboard') }}">Mon tableau de bord</a></li>
            <hr>
            {% endif %}
            <li><a class="dropdown-item" href="{{ path('app_subscription') }}">Abonnement</a></li>
            <hr>
            <li><a class="dropdown-item" href="{{ path('app_feeling') }}">Feeling</a></li>
            <hr>
            <li><a class="dropdown-item" href="{{ path('app_need') }}">Besoins</a></li>
            <hr>
            <li><a class="dropdown-item" href="{{ path('app_action') }}">Actions</a></li>
            <hr>
            <li><a class="dropdown-item" href="{{ path('app_block') }}">Blocages</a></li>
            <hr>
            <li><a class="dropdown-item" href="{{ path('app_about') }}">À propos</a></li>
            <hr>
            <li><a class="dropdown-item" href="{{ path('app_faq') }}">FAQ</a></li>
            <hr>

            {% if app.user %}
                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Se déconnecter</a></li>
            {% else %}
                <li><a class="dropdown-item text-primary" href="{{ path('app_login') }}">Se connecter</a></li>
            {% endif %}
        </ul>
    </div>
</div>
