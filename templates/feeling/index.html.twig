{% extends 'base.html.twig' %}

{% block title %}Liste des émotions{% endblock %}

{% block body %}

<!-- Section Feelings -->
<div class="mt-5">
    <h2 class="text-center mb-4">Feelings par émotion</h2>

    {% if feelingsByEmotion is not empty %}
    <div id="carouselFeelingsByEmotion" class="carousel slide">

        <!-- Indicators -->
        <div class="carousel-indicators">
            {% for emotion, feelings in feelingsByEmotion %}
                <button type="button" 
                        data-bs-target="#carouselFeelingsByEmotion" 
                        data-bs-slide-to="{{ loop.index0 }}" 
                        class="{{ loop.first ? 'active' : '' }}" 
                        aria-current="{{ loop.first ? 'true' : 'false' }}" 
                        aria-label="Slide {{ loop.index }}">
                    {{ emotion }}
                </button>
            {% endfor %}
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            {% for emotion, feelings in feelingsByEmotion %}
                <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                    <h3 class="text-center mb-3">{{ emotion }}</h3>

                    {% if feelings is empty %}
                        <p class="text-center">Aucun besoin trouvé pour cette émotion.</p>
                    {% else %}
                        <div class="d-flex flex-column align-items-center gap-3">
                            {% for feeling in feelings %}
                                <div class="feeling-toggle-title text-center" data-feeling-id="{{ feeling.id }}" 
                                     style="cursor:pointer; width:80%; padding:1rem; border-radius:12px; background-color: rgba(255,255,255,0.1);">
                                    
                                    <h5>{{ feeling.title }}</h5>

                                </div>
                                    <div class="feeling-content d-none mt-2" id="contentFeeling{{ feeling.id }}">
                                        {{ include('feeling/_read.html.twig', { feeling: feeling }) }}
                                    </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselFeelingsByEmotion" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselFeelingsByEmotion" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>

    </div>
{% else %}
    <p class="text-center text-white">Aucun feeling trouvé.</p>
{% endif %}
</div>


{% endblock %}

{% block javascripts %}

    <script>
        // On attend que le DOM soit chargé
        document.addEventListener('DOMContentLoaded', function() {

            // On cible tous les éléments qui déclenchent le choix d’un "user need"
            document.querySelectorAll('.user-need-title').forEach(function(el) {

                // Ajout d’un écouteur sur chaque titre
                el.addEventListener('click', function() {

                    // Récupération de l'ID depuis l’attribut data-id
                    const id = this.dataset.id;

                    // Sécurité : on ne fait rien si l’ID est manquant
                    if (!id) {
                        console.warn('Aucun ID trouvé sur cet élément.');
                        return;
                    }

                    // Envoi de la requête AJAX vers la route Symfony
                    fetch('{{ path('set_selected_user_need') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            // Jeton CSRF généré côté serveur (sécurité)
                            'X-CSRF-TOKEN': '{{ csrf_token('set_user_need') }}'
                        },
                        // On envoie l’ID du besoin au backend
                        body: JSON.stringify({ id: id })
                    })
                    .then(res => {
                        // Vérifie que la réponse est OK
                        if (!res.ok) {
                            throw new Error('Erreur serveur : ' + res.status);
                        }
                        return res.text();
                    })
                    .then(data => {
                        // Confirmation dans la console
                        console.log('✅ ID enregistré en session :', data);

                        // (Optionnel) Feedback visuel temporaire pour l’utilisateur
                        /*el.classList.add('bg-success', 'text-white');
                        setTimeout(() => {
                            el.classList.remove('bg-success', 'text-white');
                        }, 1500);*/
                    })
                    .catch(err => {
                        // Gestion d’erreur propre
                        console.error('⚠️ Erreur lors de l’enregistrement :', err);
                    });
                });
            });
        });
        </script>

{% endblock %}
