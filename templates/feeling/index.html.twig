{% extends 'base.html.twig' %}

{% block title %}Ressentis et émotions — Selfly{% endblock %}

{% block meta_description %}Explorez vos émotions et ressentis par catégorie. Apprenez à les reconnaître, les comprendre et identifier les besoins qui se cachent derrière elles.{% endblock %}

{% block body %}

{% include 'partials/_hero.html.twig' with {
    imageUrl: '/images/feelings/hero.jpg',
    title: 'Explorez vos émotions',
    text: 'Choisissez une émotion pour découvrir les ressentis associés et identifier vos besoins.',
    id: 'feeling-hero'
} %}

<main class="container">

    {{ include('partials/_entity_carousel.html.twig', {
        carousel_id:    'carouselFeelingsByEmotion',
        items_by_group: feelingsByEmotion,
        item_key:       'feeling',
        read_template:  'feeling/_read.html.twig',
        prefix:         'feeling',
        image_base_path:'/images/feelings',
        text_bloc_vars: {
            title:        'Ressentis',
            subtitle:     'par émotion',
            description:  'Apprenez à reconnaître et à comprendre vos ressentis et émotions',
            popover_text: 'Ici, tu peux expliquer plus en détail le concept de ressentis et émotions.',
            btn_label:    'Que faire de mes émotions ?',
            heading_id:   'feeling-title'
        }
    }) }}

</main>

{% endblock %}
