{% extends 'base.html.twig' %}

{% block title %}Liste des émotions{% endblock %}

{% block body %}
<!-- MOBILE -->
<div class="d-lg-none mt-5">
    <h2 class="text-center mb-4">Feelings par émotion</h2>

    <div id="carouselFeelingsByEmotion" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            {% for emotion, feelings in feelingsByEmotion %}
                <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                    <h3 class="text-center mb-3">{{ emotion }}</h3>

                    {% for feeling in feelings %}
                        <div class="mb-2">
                            <button class="btn btn-outline-light w-100"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#feeling{{ feeling.id }}">
                                {{ feeling.title }}
                            </button>

                            <div id="feeling{{ feeling.id }}" class="collapse mt-2">
                                {{ include('feeling/_read.html.twig', { feeling }) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselFeelingsByEmotion" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselFeelingsByEmotion" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>

<!-- DESKTOP -->
<div class="d-none d-lg-block mt-5">
    <h2 class="text-center mb-4">Feelings par émotion</h2>

    {% for emotion, feelings in feelingsByEmotion %}
        <h3 class="mb-3">{{ emotion }}</h3>

        <div class="row g-3 mb-5">
            {% for feeling in feelings %}
                <div class="col-md-4">
                    <div class="card h-100">

                        <div class="card-body">
                            <!-- Titre cliquable -->
                            <h5 class="card-title">
                                <button class="btn btn-link p-0 text-decoration-none"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#feeling{{ feeling.id }}"
                                        aria-expanded="false"
                                        aria-controls="feeling{{ feeling.id }}">
                                    {{ feeling.title }}
                                </button>
                            </h5>

                            <!-- Contenu masqué -->
                            <div id="feeling{{ feeling.id }}" class="collapse mt-2">
                                {{ include('feeling/_read.html.twig', { feeling }) }}
                            </div>
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>

    {% endfor %}
</div>


{% endblock %}

{% block javascripts %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.user-need-title').forEach(function(el) {
                el.addEventListener('click', function() {

                    const id = this.dataset.id;

                    if (!id) {
                        console.warn('Aucun ID trouvé sur cet élément.');
                        return;
                    }

                    fetch('{{ path('set_selected_user_need') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'X-CSRF-TOKEN': '{{ csrf_token('set_user_need') }}'
                        },
                        body: JSON.stringify({ id: id })
                    })
                    .then(res => {
                        if (!res.ok) {
                            throw new Error('Erreur serveur : ' + res.status);
                        }
                        return res.text();
                    })
                    .then(data => {
                        console.log('✅ ID enregistré en session :', data);
                    })
                    .catch(err => {
                        console.error('⚠️ Erreur lors de l’enregistrement :', err);
                    });
                });
            });
        });

        document.querySelectorAll('.feeling-toggle-title').forEach(function(title) {
        title.addEventListener('click', function() {
            const id = this.dataset.feelingId;
            const content = document.getElementById('contentFeeling' + id);
            if (content) {
                content.classList.toggle('d-none');
            }
        });
    });
    </script>


{% endblock %}
