<div class="collapse mt-2" id="collapseNeed{{ userNeed.id }}">
    <div class="card card-body p-3 text-center" 
         style="background: rgba(53, 53, 53, 0.2); color: #fff; border-radius: 8px;">

        <p>{{ userNeed.need.description }}</p>

        {% if userNeed.need.fulfilment is not empty %}
    <strong>Fulfilments :</strong>
    <ul class="list-unstyled mt-2">
        {% for item in userNeed.need.fulfilment %}
            <li><u>{{ item }}</u></li>
        {% endfor %}
    </ul>
{% endif %}

        <p><strong>Type :</strong> {{ userNeed.need.type }}</p>

</div>

<div>

    {% if app.user.subscription and app.user.subscription.isActive %}
        <ul>
            {% for action in userNeed.need.actions %}
                <li class="mb-3">
                    {{ action.title }}

                    <button
                        class="btn btn-sm btn-outline-primary ms-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#form-{{ userNeed.id }}-{{ action.id }}"
                        aria-expanded="false"
                        aria-controls="form-{{ userNeed.id }}-{{ action.id }}"
                    >
                        Ajouter
                    </button>

                    <div class="collapse mt-2" id="form-{{ userNeed.id }}-{{ action.id }}">
                        <div class="border p-3 rounded shadow-sm bg-light">
                            {{ include('action/_form.html.twig', { action: action }) }}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>

    {% elseif app.user and 'ROLE_USER' in app.user.roles %}
        <a href="{{ path('app_subscription') }}" class="btn btn-primary">
            S’abonner pour accéder aux actions
        </a>
    {% endif %}

</div>
