<div class="entity-container mt-3">

    <div class="entity-content">

        <!-- =========================
             DESCRIPTION
             ========================= -->
        {% if userNeed.need.description %}
            <div class="description-block">
                <button class="description-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseDescriptionUserNeed{{ userNeed.id }}"
                        aria-expanded="false"
                        aria-controls="collapseDescriptionUserNeed{{ userNeed.id }}">
                    En apprendre plus
                </button>

                <div class="collapse" id="collapseDescriptionUserNeed{{ userNeed.id }}">
                    <div class="description-content">
                        <p>{{ userNeed.need.description }}</p>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- =========================
             FULFILMENTS
             ========================= -->
        {% if userNeed.need.fulfilment is not empty %}
            <h5 class="trigger-intro mt-3">
                <strong>Comment y répondre ?</strong>
            </h5>

            <div class="trigger-list">
                {% for item in userNeed.need.fulfilment %}
                    <span class="trigger-pill">{{ item }}</span>
                {% endfor %}
            </div>

            <p class="trigger-note">
                ... un besoin peu satisfait peut générer des tensions internes
            </p>
        {% endif %}

        <!-- =========================
             TYPE
             ========================= -->
        <p class="mt-2"><strong>Type :</strong> {{ userNeed.need.type }}</p>

        <!-- =========================
             ACTIONS
             ========================= -->
        {% if app.user.subscription is defined and app.user.subscription and app.user.subscription.isActive == 1 %}
            <ul class="list-unstyled mt-3">
                {% for action in userNeed.need.actions %}
                    <div class="action-block">

                        <button class="sub-entity-btn entity-title"
                            role="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseActionForm{{ userNeed.id }}-{{ action.id }}"
                            aria-expanded="false"
                            aria-controls="collapseActionForm{{ userNeed.id }}-{{ action.id }}">
                            
                            {{ action.title }}
                        </button>

                        <div class="collapse" id="collapseActionForm{{ userNeed.id }}-{{ action.id }}">
                            <div class="action-content">

                                {{ include('action/_read.html.twig', { action: action }) }}

                            </div>
                        </div>

                    </div>
                {% endfor %}
            </ul>

        {% elseif app.user %}
            <a href="{{ path('app_subscription') }}" class="btn btn-submit mt-2">
                S’abonner pour accéder aux actions
            </a>

        {% else %}
            <p class="trigger-note mt-2">
                Connecte-toi pour accéder aux actions
            </p>
            <a href="{{ path('app_login') }}" class="btn mt-1">
                Me connecter
            </a>
        {% endif %}

    </div>
</div>