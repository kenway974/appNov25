{% extends 'base.html.twig' %}

{% block title %}Blocages et freins internes — Selfly{% endblock %}

{% block meta_description %}Identifiez vos blocages et freins internes par type. Nommer ce qui vous empêche d'avancer est la première étape pour le dépasser.{% endblock %}

{% block body %}

{% include 'partials/_hero.html.twig' with {
    imageUrl: '/images/blocks/hero.jpg',
    title: 'Comprendre vos blocages',
    text: 'Identifiez vos freins internes et découvrez des pistes pour les dépasser.',
    id: 'block-hero'
} %}

<main class="container">

    {{ include('partials/_entity_carousel.html.twig', {
        carousel_id:    'carouselBlocksByType',
        items_by_group: blocksByType,
        item_key:       'block',
        read_template:  'block/_read.html.twig',
        prefix:         'block',
        image_base_path:'/images/blocks',
        text_bloc_vars: {
            title:        'Blocages',
            subtitle:     'par type',
            description:  'Identifiez vos freins internes et découvrez des pistes pour les dépasser',
            popover_text: 'Les blocages sont des pensées ou croyances qui limitent vos actions. Les reconnaître est la première étape pour les dépasser.',
            btn_label:    'Comment les dépasser ?',
            heading_id:   'block-title'
        }
    }) }}

</main>

{% endblock %}