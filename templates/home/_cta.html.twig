<section class="container my-5" id="home-cta">

  <h2 class="text-center mb-5">
    Transforme tes émotions en actions concrètes
  </h2>

  {# =========================
     PLAN GRATUIT (TEXT ONLY)
  ========================= #}

  <div class="text-center mb-5">
    {% for plan in freePlans %}

      <h3 class="mb-2">{{ plan.title }}</h3>

      <p class="lead mb-3">
        {{ plan.description }}
      </p>

      <p class="text-muted">
        {{ plan.price }}€
      </p>

      <a href="{{ path('app_feeling') }}" class="btn btn-outline-primary mt-2">
        Commencer gratuitement
      </a>

    {% endfor %}
  </div>


  {# =========================
     PLANS PAYANTS - DESKTOP
  ========================= #}

  <div class="row d-none d-md-flex justify-content-center g-4">

    {% for plan in paidPlans %}
      <div class="col-md-4 d-flex">

        <div class="card w-100 text-center shadow-sm">

          <img src="images/plans/plan-premium.jpg"
               alt="Version premium"
               class="card-img-top">

          <div class="card-body d-flex flex-column">

            <h3 class="card-title">{{ plan.title }}</h3>

            <p class="card-text flex-grow-1">
              {{ plan.description }}
            </p>

            <p class="price fw-bold fs-5">
              {{ plan.price }}€
            </p>

            <a href="{{ path('app_subscription') }}"
               class="btn btn-primary mt-3">
              Continuer
            </a>

          </div>

        </div>

      </div>
    {% endfor %}

  </div>


{# =========================
     PLANS PAYANTS - MOBILE CAROUSEL
  ========================= #}

<div id="plansCarousel"
     class="carousel slide d-md-none mt-4"
     data-bs-ride="carousel">

  <div class="carousel-inner">

    {% for plan in paidPlans %}
      <div class="carousel-item {% if loop.first %}active{% endif %}">

        <div class="card mx-3 text-center shadow-sm">

          <img src="images/plans/plan-premium.jpg"
               alt="Version premium"
               class="card-img-top">

          <div class="card-body d-flex flex-column">

            <h3 class="card-title">{{ plan.title }}</h3>

            <p class="card-text flex-grow-1">
              {{ plan.description }}
            </p>

            <p class="price fw-bold fs-5">
              {{ plan.price }}€
            </p>

            <a href="{{ path('app_subscription') }}"
               class="btn btn-primary mt-3">
              Continuer
            </a>

          </div>

        </div>

      </div>
    {% endfor %}

  </div>

  {# =========================
     CONTROLS (prev / next)
      ========================= #}

      <button class="carousel-control-prev"
              type="button"
              data-bs-target="#plansCarousel"
              data-bs-slide="prev">

        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Précédent</span>

      </button>

      <button class="carousel-control-next"
              type="button"
              data-bs-target="#plansCarousel"
              data-bs-slide="next">

        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Suivant</span>

      </button>

    </div>

  </div>

</section>