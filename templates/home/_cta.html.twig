<section class="container my-5" id="home-cta">

  <h2 class="text-center mb-5">
    Transforme tes émotions en actions concrètes
  </h2>

  {# =========================
     PLAN GRATUIT (TEXT ONLY)
  ========================= #}

  <div class="text-center mb-5">
    {% for plan in freePlans %}

      <h3 class="mb-2">{{ plan.title }}</h3>

      <p class="lead mb-3">
        {{ plan.description }}
      </p>

      <p class="text-muted">
        {{ plan.price }}€
      </p>

      <a href="{{ path('app_feeling') }}" class="btn btn-outline-primary mt-2">
        Commencer gratuitement
      </a>

    {% endfor %}
  </div>


  {# =========================
     PLANS PAYANTS
  ========================= #}

  <div class="row justify-content-center g-4">

    {% for plan in paidPlans %}
      <div class="col-12 col-md-4 d-flex">

        <div class="card w-100 text-center shadow-sm">

          <img src="{{ asset('images/plans/plan-premium.jpg') }}"
               alt="Version premium"
               class="card-img-top">

          <div class="card-body d-flex flex-column">

            <h3 class="card-title">{{ plan.title }}</h3>

            <p class="card-text flex-grow-1">
              {{ plan.description }}
            </p>

            <p class="price fw-bold fs-5">
              {{ plan.price }}€
            </p>

            <a href="{{ path('app_subscription') }}"
               class="btn btn-primary mt-3">
              Continuer
            </a>

          </div>

        </div>

      </div>
    {% endfor %}

  </div>

</section>