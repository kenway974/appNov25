{% extends 'base.html.twig' %}

{% block title %}Besoins fondamentaux — Selfly{% endblock %}

{% block meta_description %}Identifiez vos besoins fondamentaux par catégorie. Comprendre ce qui vous manque est la première étape pour mieux agir et retrouver l'équilibre.{% endblock %}

{% block body %}

{% include 'partials/_hero.html.twig' with {
    imageUrl: '/images/needs/hero.jpg',
    title: 'Comprendre vos besoins',
    text: 'Identifiez ce qui vous manque réellement et découvrez comment y répondre.',
    id: 'need-hero'
} %}

<main class="container">

    {{ include('partials/_entity_carousel.html.twig', {
        carousel_id:    'carouselNeedsByType',
        items_by_group: needsByType,
        item_key:       'need',
        read_template:  'need/_read.html.twig',
        prefix:         'need',
        image_base_path:'/images/needs',
        text_bloc_vars: {
            title:        'Besoins',
            subtitle:     'par catégorie',
            description:  'Identifiez ce qui vous manque réellement et découvrez comment y répondre',
            popover_text: 'Reconnaître ses besoins profonds permet de mieux comprendre ses émotions et de trouver des actions adaptées.',
            btn_label:    'Comment y répondre ?',
            heading_id:   'need-title'
        }
    }) }}

</main>

{% endblock %}
