{# templates/dashboard/partials/_actions.html.twig #}

<div class="dashboard-entity">
    <h2 class="dashboard-entity-title text-center mb-4">Actions</h2>
    {% if userActions is not empty %}
        <div class="user-actions">
            {{ include('user_action/_list.html.twig') }}
        </div>
