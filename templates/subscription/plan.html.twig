{% extends 'base.html.twig' %}

{% block title %}Mon abonnement{% endblock %}

{% block body %}
<div class="container py-5">

    {# =========================
       1. UTILISATEUR NON CONNECTÉ
       ========================= #}
    {% if not app.user %}

        <div class="text-center">
            <h1 class="fw-bold mb-3">Connexion requise</h1>
            <p class="text-muted mb-4">Vous devez être connecté pour accéder à votre abonnement.</p>

            <a href="{{ path('app_login') }}" class="btn btn-primary">
                Se connecter
            </a>
        </div>

    {% else %}

        {% set subscription = app.user.subscription ?? null %}

        {# =========================
           2. PAS D'ABONNEMENT
           ========================= #}
        {% if not subscription %}

            <div class="text-center mb-5">
                <h1 class="fw-bold">Choisissez votre formule</h1>
                <p class="text-muted">Des options simples, sans surprise.</p>
            </div>

            <div class="row justify-content-center g-4">
                {% for plan in plans %}
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">

                                <h3 class="text-center fw-bold mb-3">
                                    {{ plan.title }}
                                </h3>

                                <p class="text-center text-muted">
                                    {{ plan.description }}
                                </p>

                                <div class="text-center my-4">
                                    <span class="display-6 fw-bold">
                                        {{ plan.price|number_format(2, ',', ' ') }} €
                                    </span>
                                    <div class="text-muted small">
                                        pour {{ plan.duration }} jours
                                    </div>
                                </div>

                                {% if plan.features %}
                                    <ul class="list-unstyled mb-4">
                                        {% for feature in plan.features %}
                                            <li>✓ {{ feature }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}

                                <form method="POST" action="{{ path('app_create_checkout_session') }}">
                                    <input type="hidden" name="planId" value="{{ plan.id }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
                                    <button type="submit" class="btn btn-primary w-100">
                                        S'abonner
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

        {# =========================
           3 & 4. ABONNEMENT EXISTANT
           ========================= #}
        {% else %}

            <div class="text-center mb-5">
                <h1 class="fw-bold">Votre abonnement</h1>
            </div>

            <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px;">
                <div class="card-body text-center">

                    <h3 class="fw-bold mb-3">
                        {{ subscription.plan.title ?? 'Premium' }}
                    </h3>

                    <p class="text-muted">
                        {{ subscription.plan.price ?? '4.99€' }}
                    </p>

                    <p>
                        Début : {{ subscription.startDate ? subscription.startDate|date('d/m/Y') : '-' }}
                    </p>
                    <p>
                        Fin : {{ subscription.endDate ? subscription.endDate|date('d/m/Y') : '-' }}
                    </p>

                    {# =========================
                       ABONNEMENT INACTIF
                       ========================= #}
                    {% if not subscription.isActive %}

                        <span class="badge bg-danger mb-3">Inactif</span>

                        <form action="{{ path('app_create_checkout_session') }}" method="POST">
                            <input type="hidden" name="planId" value="{{ subscription.plan.id }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
                            <button type="submit" class="btn btn-primary w-100 mt-3">
                                Renouveler l'abonnement
                            </button>
                        </form>

                    {# =========================
                       ABONNEMENT ACTIF
                       ========================= #}
                    {% else %}

                        <span class="badge bg-success mb-3">Actif</span>

                        <button class="btn btn-outline-danger w-100 mt-3">
                            Résilier l'abonnement
                        </button>

                    {% endif %}

                </div>
            </div>

        {% endif %}

    {% endif %}

</div>
{% endblock %}