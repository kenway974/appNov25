{% if notifications is not empty %}
    {% for notif in notifications %}
        <li class="dropdown-item d-flex justify-content-between align-items-start" data-id="{{ notif.id }}">

            <div class="notif-content">

                {# TITRE #}
                {% if notif.title %}
                    <strong>{{ notif.title }}</strong><br>
                {% endif %}

                {# MESSAGE #}
                {% if notif.message %}
                    <p class="mb-0" style="white-space: normal; overflow-wrap: break-word;">
                        {{ notif.message }}
                    </p>
                {% else %}
                    <em>Pas de message</em><br>
                {% endif %}

                {# TYPE (bonus utile debug / UX) #}
                {% if notif.type %}
                    <small class="text-muted d-block">
                        Type : {{ notif.type }}
                    </small>
                {% endif %}

                {# DATE #}
                {% if notif.createdAt %}
                    <small class="text-muted d-block">
                        Reçue le {{ notif.createdAt|date('d/m/Y H:i') }}
                    </small>
                {% endif %}

                {# STATUS LECTURE #}
                {% if not notif.isRead %}
                    <span class="badge bg-warning">Non lue</span>
                {% else %}
                    <span class="badge bg-secondary">Lue</span>
                {% endif %}

            </div>

            <form method="post"
                      action="{{ path('app_action_complete', { id: notif.userAction.id }) }}">
                    <input type="hidden"
                           name="_token"
                           value="{{ csrf_token('complete_user_action_' ~ notif.userAction.id) }}">
                    <button class="btn btn-success">Terminer</button>
                </form>

        </li>

        <li><hr class="dropdown-divider"></li>
    {% endfor %}
{% else %}
    <li class="dropdown-item text-muted">
        Aucune notification
    </li>
{% endif %}