{% extends 'base.html.twig' %}

{% block title %}Actions concrètes — Selfly{% endblock %}

{% block meta_description %}Découvrez des actions concrètes classées par intention pour avancer malgré vos blocages. Physique, mental, social ou créatif : trouvez ce qui vous correspond.{% endblock %}

{% block body %}

{% include 'partials/_hero.html.twig' with {
    imageUrl: '/images/actions/hero.jpg',
    title: 'Passez à l\'action',
    text: 'Découvrez des actions concrètes pour avancer malgré vos blocages.',
    id: 'action-hero'
} %}

<main class="container">

    {{ include('partials/_entity_carousel.html.twig', {
        carousel_id:    'carouselActionsByIntension',
        items_by_group: actions,
        item_key:       'action',
        read_template:  'action/_read.html.twig',
        prefix:         'action',
        image_base_path:'/images/actions',
        text_bloc_vars: {
            title:        'Actions',
            subtitle:     'par intention',
            description:  'Découvrez des actions concrètes adaptées à vos besoins',
            popover_text: 'Les actions sont classées par intention pour vous aider à trouver rapidement ce qui vous correspond.',
            btn_label:    'Comment choisir ?',
            heading_id:   'action-title'
        }
    }) }}

</main>

{% endblock %}
