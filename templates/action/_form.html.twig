<form method="post" action="{{ path('app_dashboard') }}">

    <input type="hidden" name="needId" value="{{ userNeed.id }}">
    <input type="hidden" name="actionId" value="{{ action.id }}">
    <input type="hidden" name="user_action[_token]" value="{{ csrf_token('user_action') }}">


    <div class="mb-3">
        <label class="form-label">Date limite</label>
        <input type="date"
               name="user_action[deadline]"
               class="form-control"
               required>
    </div>

    {% if action.isRecurring == true %}
        <div class="mb-3">
            <label class="form-label">Fréquence (par semaine)</label>
            <input type="number"
                   name="user_action[frequency]"
                   min="1"
                   max="7"
                   value="1"
                   class="form-control">
        </div>
    {% endif %}


    <button type="submit" class="btn btn-submit">
        Ajouter cette action à mon profil
    </button>

</form>